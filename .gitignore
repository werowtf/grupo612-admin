# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example SÍ se versiona, como plantilla)
.env
.env.local
.env.*.local
.env.development
.env.production

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# base de datos local embebida
/.pgdata

# caché de datos de idioma de tesseract.js (se regenera en tmpdir)
*.traineddata

# archivos de asistentes de IDE generados por `prisma init` (no son parte de la app)
/.agents
/.windsurf
/.claude/skills
skills-lock.json
