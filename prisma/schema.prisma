// Plataforma Administrativa y Financiera — Grupo 612
// Schema base: fundación (usuarios/sucursales) + conciliación bancaria.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// Fundación: usuarios, roles y sucursales
// ─────────────────────────────────────────────────────────────

enum UserRole {
  ADMIN // acceso total
  GERENTE // gerente de sucursal
  CONTADOR // contabilidad / conciliación (interna)
  CONTADOR_EXTERNO // contabilidad externa: sólo sube estados de cuenta
  COMPRAS // sólo registra compras (egresos) diarias
  CAJERO // captura operativa
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String
  passwordHash String
  role         UserRole         @default(CONTADOR)
  active       Boolean          @default(true)
  venues       UserVenue[]
  auditLogs    AuditLog[]
  statements   BankStatement[]  @relation("ImportedBy")
  cortes       Corte[]          @relation("CorteCreatedBy")
  entries      FinancialEntry[] @relation("EntryCreatedBy")
  dailySales   DailySale[]      @relation("DailySaleCreatedBy")
  conceptRules ConceptRule[]
  cuentasPorPagar CuentaPorPagar[]
  facturasCafeteria FacturaCafeteria[] @relation("FacturaCafeteriaCreatedBy")
  documents    Document[]       @relation("DocumentUploadedBy")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model Venue {
  id              String           @id @default(cuid())
  name            String
  slug            String           @unique
  rfc             String?
  active          Boolean          @default(true)
  users           UserVenue[]
  bankAccounts    BankAccount[]
  cortes          Corte[]
  entries         FinancialEntry[]
  entryCategories EntryCategory[]
  dailySales      DailySale[]
  cuentasPorPagar CuentaPorPagar[]
  cafeterias      Cafeteria[]
  documents       Document[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// Relación usuario ↔ sucursal (acceso). Los ADMIN ven todas.
model UserVenue {
  userId  String
  venueId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  @@id([userId, venueId])
}

// ─────────────────────────────────────────────────────────────
// Banca: cuentas, estados de cuenta importados y movimientos
// ─────────────────────────────────────────────────────────────

enum Bank {
  SANTANDER
  BANBAJIO
  OTRO
}

model BankAccount {
  id            String            @id @default(cuid())
  venueId       String
  venue         Venue             @relation(fields: [venueId], references: [id], onDelete: Cascade)
  bank          Bank
  alias         String // p.ej. "Uno — Santander"
  accountNumber String? // últimos dígitos / número visible
  clabe         String?
  currency      String            @default("MXN")
  transactions  BankTransaction[]
  statements    BankStatement[]
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@unique([venueId, bank, accountNumber])
}

enum StatementStatus {
  IMPORTED // importado, pendiente de revisión
  REVIEWED // revisado por contabilidad
}

// Un estado de cuenta = un archivo importado (lote).
model BankStatement {
  id             String            @id @default(cuid())
  bankAccountId  String
  bankAccount    BankAccount       @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  bank           Bank
  fileName       String
  periodStart    DateTime?
  periodEnd      DateTime?
  rowCount       Int               @default(0)
  importedCount  Int               @default(0) // movimientos nuevos guardados
  duplicateCount Int               @default(0) // filas omitidas por duplicado
  totalCargos    Decimal           @default(0) @db.Decimal(14, 2)
  totalAbonos    Decimal           @default(0) @db.Decimal(14, 2)
  status         StatementStatus   @default(IMPORTED)
  importedById   String?
  importedBy     User?             @relation("ImportedBy", fields: [importedById], references: [id], onDelete: SetNull)
  transactions   BankTransaction[]
  createdAt      DateTime          @default(now())
}

enum TxDirection {
  CARGO // salida (-)
  ABONO // entrada (+)
}

// Clasificación del cliente: TRANSFERENCIA / CHEQUE / DEPOSITO / COMISION / GASTO_TARJETA.
// El estado de cuenta es el de la tarjeta del negocio: todo cargo/abono que no
// calce con una regla más específica se clasifica como GASTO_TARJETA (antes OTRO).
enum TxCategory {
  TRANSFERENCIA
  CHEQUE
  DEPOSITO
  COMISION
  GASTO_TARJETA
}

enum TxStatus {
  PENDIENTE // sin conciliar
  CONCILIADO
  IGNORADO
}

model BankTransaction {
  id               String        @id @default(cuid())
  bankAccountId    String
  bankAccount      BankAccount   @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  statementId      String
  statement        BankStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date             DateTime
  time             String? // "02:46"
  description      String
  descriptionLong  String?
  direction        TxDirection
  amount           Decimal       @db.Decimal(14, 2) // siempre positivo; el signo lo da direction
  balance          Decimal?      @db.Decimal(14, 2)
  reference        String?
  concept          String?
  category         TxCategory    @default(GASTO_TARJETA)
  autoCategorized  Boolean       @default(true) // false si un humano la ajustó
  counterpartyName String?
  counterpartyRfc  String?
  trackingKey      String? // clave de rastreo SPEI
  // El estado de cuenta ES la tarjeta del negocio: todo cargo/abono importado
  // pertenece a la conciliación, así que entra ya conciliado (ver proyecto:
  // conversación con el cliente sobre el alcance de la conciliación bancaria).
  status           TxStatus      @default(CONCILIADO)
  note             String?
  dedupeHash       String
  raw              Json?

  // Conciliación con cortes de caja: un depósito puede vincularse a un corte.
  corteId String?
  corte   Corte?  @relation("CorteDeposits", fields: [corteId], references: [id], onDelete: SetNull)

  documents Document[] @relation("DocumentBankTransaction")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([bankAccountId, dedupeHash])
  @@index([bankAccountId, date])
  @@index([statementId])
  @@index([category])
  @@index([corteId])
}

/// Aprendida de correcciones manuales: cuando alguien corrige la categoría de
/// un movimiento en Movimientos (updateTransactionCategory), ese concepto
/// queda registrado aquí para que la próxima importación ya lo reconozca sin
/// depender de que el patrón esté escrito a mano en classify.ts. Global (no
/// por negocio): el texto del concepto lo define el banco, no la sucursal.
model ConceptRule {
  id          String     @id @default(cuid())
  /// Concepto normalizado (mayúsculas, sin acentos) — ver normalizeConcept().
  concept     String     @unique
  category    TxCategory
  createdById String?
  createdBy   User?      @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

/// Cuentas por pagar de la sección "Por pagar": deudas puntuales (renta,
/// proveedores, lo que sea) capturadas a mano, con un botón para marcarlas
/// pagadas. Las propinas por pagar NO viven aquí — esas ya se capturan por
/// corte (Corte.propinasPorPagar) y esta sección sólo suma esa columna.
model CuentaPorPagar {
  id          String    @id @default(cuid())
  venueId     String
  venue       Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  date        DateTime
  concept     String
  amount      Decimal   @db.Decimal(14, 2)
  /// null = pendiente; con fecha = pagada (y cuándo).
  paidAt      DateTime?
  createdById String?
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([venueId, paidAt])
}

// ─────────────────────────────────────────────────────────────
// Auditoría
// ─────────────────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String // p.ej. "statement.import", "tx.recategorize"
  entity    String? // "BankTransaction"
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([entity, entityId])
}

// ─────────────────────────────────────────────────────────────
// Cortes de caja (Corte Z / cierre de caja)
// ─────────────────────────────────────────────────────────────

enum CorteSource {
  MANUAL // captura manual
  EXCEL // importado de Excel (Soft Restaurant)
  OCR // leído de foto del ticket
}

model Corte {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  // Identificación
  date         DateTime // fecha del corte
  turno        String? // matutino / vespertino / etc.
  cajera       String?
  estacion     String?
  folioCorteZ  String?
  folioInicial String?
  folioFinal   String?

  // Ventas por forma de pago
  pagoEfectivo    Decimal @default(0) @db.Decimal(14, 2)
  pagoVisa        Decimal @default(0) @db.Decimal(14, 2)
  pagoMastercard  Decimal @default(0) @db.Decimal(14, 2)
  pagoAmex        Decimal @default(0) @db.Decimal(14, 2)
  pagoVales       Decimal @default(0) @db.Decimal(14, 2)
  pagoOtros       Decimal @default(0) @db.Decimal(14, 2)
  totalFormasPago Decimal @default(0) @db.Decimal(14, 2)

  // Propinas por forma de pago
  propinaEfectivo   Decimal @default(0) @db.Decimal(14, 2)
  propinaVisa       Decimal @default(0) @db.Decimal(14, 2)
  propinaMastercard Decimal @default(0) @db.Decimal(14, 2)
  propinaAmex       Decimal @default(0) @db.Decimal(14, 2)
  totalPropinas     Decimal @default(0) @db.Decimal(14, 2)

  // Ventas por tipo de producto
  ventaAlimentos Decimal @default(0) @db.Decimal(14, 2)
  ventaBebidas   Decimal @default(0) @db.Decimal(14, 2)
  ventaOtros     Decimal @default(0) @db.Decimal(14, 2)

  // Ventas por terminal (además de las formas de pago con tarjeta de arriba)
  ventaTerminalBanbajio Decimal @default(0) @db.Decimal(14, 2)
  ventaTerminalPayefy   Decimal @default(0) @db.Decimal(14, 2)
  ventaTerminalWuzi     Decimal @default(0) @db.Decimal(14, 2)

  /// Propinas ya cobradas pero que todavía no se le han pagado al personal.
  propinasPorPagar Decimal @default(0) @db.Decimal(14, 2)

  // Totales
  subtotal   Decimal @default(0) @db.Decimal(14, 2)
  descuentos Decimal @default(0) @db.Decimal(14, 2)
  ventaNeta  Decimal @default(0) @db.Decimal(14, 2)
  iva        Decimal @default(0) @db.Decimal(14, 2)
  totalVenta Decimal @default(0) @db.Decimal(14, 2)

  // Control de caja
  efectivoInicial   Decimal @default(0) @db.Decimal(14, 2)
  efectivoDeclarado Decimal @default(0) @db.Decimal(14, 2)
  retiros           Decimal @default(0) @db.Decimal(14, 2)
  depositos         Decimal @default(0) @db.Decimal(14, 2)
  sobranteFaltante  Decimal @default(0) @db.Decimal(14, 2)

  // Operación
  cuentasNormales   Int?
  cuentasCanceladas Int?
  comensales        Int?
  cuentaPromedio    Decimal? @db.Decimal(14, 2)

  // Origen y evidencia
  source      CorteSource @default(MANUAL)
  fileName    String?
  rawText     String? // texto OCR crudo
  raw         Json? // datos crudos del Excel u OCR
  notes       String?
  createdById String?
  createdBy   User?       @relation("CorteCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  // Depósitos bancarios vinculados (conciliación de ventas con tarjeta).
  deposits  BankTransaction[] @relation("CorteDeposits")
  documents Document[]        @relation("DocumentCorte")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, folioCorteZ])
  @@index([venueId, date])
}

// ─────────────────────────────────────────────────────────────
// Ingresos y egresos (movimientos manuales / compras)
// ─────────────────────────────────────────────────────────────

enum EntryType {
  INGRESO
  EGRESO
}

enum PaymentMethod {
  EFECTIVO
  TARJETA
  TRANSFERENCIA
  CHEQUE
  OTRO
}

enum EntrySource {
  MANUAL
  OCR // capturado desde foto del ticket
  SISTEMA // generado automáticamente (p.ej. facturación de cafetería)
}

/// Catálogo de conceptos de ingresos/egresos. Es por negocio: cada sede lleva
/// su propia lista en el libro contable, así que no se comparte entre venues.
model EntryCategory {
  id        String    @id @default(cuid())
  venueId   String
  venue     Venue     @relation(fields: [venueId], references: [id], onDelete: Cascade)
  type      EntryType
  name      String
  /// Orden en que se muestran en el selector.
  sortOrder Int       @default(0)
  active    Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, type, name])
  @@index([venueId, type, active])
}

model FinancialEntry {
  id            String        @id @default(cuid())
  venueId       String
  venue         Venue         @relation(fields: [venueId], references: [id], onDelete: Cascade)
  type          EntryType
  date          DateTime
  amount        Decimal       @db.Decimal(14, 2)
  category      String // "Insumos", "Bebidas", "Renta", "Venta", etc.
  description   String?
  supplier      String? // proveedor / beneficiario
  rfc           String?
  paymentMethod PaymentMethod @default(EFECTIVO)
  reference     String?
  folio         String? // folio del ticket / factura
  source        EntrySource   @default(MANUAL)

  // Evidencia (foto del ticket) almacenada en la BD por ahora (migrar a R2 después).
  photo     Bytes?
  photoMime String?
  rawText   String? // texto OCR crudo

  notes       String?
  createdById String?
  createdBy   User?      @relation("EntryCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  documents   Document[] @relation("DocumentEntry")
  facturaCafeteria FacturaCafeteria?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([venueId, date])
  @@index([type])
  @@index([category])
  @@index([createdById])
}

enum DailySaleSource {
  MANUAL // capturada a mano (negocio sin corte ese día)
  CORTE // derivada automáticamente del/los corte(s) de caja del día
}

/// Venta diaria del negocio, con el mismo desglose que usa la contadora en su
/// libro: un renglón por día con el total dividido por método de pago
/// (efectivo/tarjeta/crédito) y por tipo de consumo (comida/bebida, montos
/// sin impuesto). Va aparte de FinancialEntry porque esa tabla es un monto +
/// un método de pago por movimiento, y aquí un solo día trae varios montos a
/// la vez.
///
/// El corte de caja es la fuente de la verdad: cuando el negocio sube su
/// corte del día, este renglón se recalcula solo a partir de él (ver
/// `src/lib/daily-sales/sync.ts`). La captura manual sólo aplica a días sin
/// corte.
model DailySale {
  id            String          @id @default(cuid())
  venueId       String
  venue         Venue           @relation(fields: [venueId], references: [id], onDelete: Cascade)
  date          DateTime
  source        DailySaleSource @default(MANUAL)

  efectivo      Decimal  @db.Decimal(14, 2) @default(0)
  tarjeta       Decimal  @db.Decimal(14, 2) @default(0)
  credito       Decimal  @db.Decimal(14, 2) @default(0)
  /// Notas de a quién/qué se le dio a crédito ese día (texto libre, como en el Excel).
  statusCredito String?

  /// Venta sin impuesto, dividida en comida y bebida.
  comida        Decimal  @db.Decimal(14, 2) @default(0)
  bebida        Decimal  @db.Decimal(14, 2) @default(0)

  notes         String?
  createdById   String?
  createdBy     User?    @relation("DailySaleCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([venueId, date])
  @@index([venueId, date])
}

// ─────────────────────────────────────────────────────────────
// Documentos (repositorio centralizado)
// ─────────────────────────────────────────────────────────────

/**
 * Categorías sugeridas; se guarda como texto libre para no limitar de más.
 */
enum DocumentCategory {
  FACTURA
  CONTRATO
  COMPROBANTE
  IDENTIFICACION
  ACTA_CONSTITUTIVA
  PERMISO
  RECIBO
  OTRO
}

model Document {
  id      String @id @default(cuid())
  venueId String
  venue   Venue  @relation(fields: [venueId], references: [id], onDelete: Cascade)

  title    String
  category DocumentCategory @default(OTRO)
  tags     String? // separadas por coma, búsqueda simple
  notes    String?

  fileName String
  mime     String
  size     Int // bytes
  file     Bytes // contenido almacenado en la BD por ahora (migrar a R2 después)

  // Vínculos opcionales a otros registros de la plataforma.
  corteId           String?
  corte             Corte?           @relation("DocumentCorte", fields: [corteId], references: [id], onDelete: SetNull)
  entryId           String?
  entry             FinancialEntry?  @relation("DocumentEntry", fields: [entryId], references: [id], onDelete: SetNull)
  bankTransactionId String?
  bankTransaction   BankTransaction? @relation("DocumentBankTransaction", fields: [bankTransactionId], references: [id], onDelete: SetNull)

  uploadedById String?
  uploadedBy   User?    @relation("DocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([venueId, createdAt])
  @@index([category])
  @@index([corteId])
  @@index([entryId])
  @@index([bankTransactionId])
}

// ─────────────────────────────────────────────────────────────
// Cafetería (Comisariato): pedidos diarios de los cafés-cliente y
// facturación mensual derivada de ellos.
// ─────────────────────────────────────────────────────────────

/// Un café-cliente al que Biznaga le vende producto de cocina a diario.
model Cafeteria {
  id        String              @id @default(cuid())
  venueId   String
  venue     Venue               @relation(fields: [venueId], references: [id], onDelete: Cascade)
  name      String
  active    Boolean             @default(true)
  sortOrder Int                 @default(0)
  productos ProductoCafeteria[]
  pedidos   PedidoCafeteria[]
  facturas  FacturaCafeteria[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([venueId, name])
}

/// Catálogo de productos y precio (sin IVA) por café. El precio puede variar
/// entre cafés aunque el producto se llame igual.
model ProductoCafeteria {
  id          String            @id @default(cuid())
  cafeteriaId String
  cafeteria   Cafeteria         @relation(fields: [cafeteriaId], references: [id], onDelete: Cascade)
  name        String
  price       Decimal           @db.Decimal(14, 2)
  active      Boolean           @default(true)
  sortOrder   Int               @default(0)
  pedidos     PedidoCafeteria[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cafeteriaId, name])
}

/// Cantidad pedida de un producto en un día. `unitPrice` se congela al
/// capturar el pedido para no alterar facturación ya calculada si el precio
/// del producto cambia después.
model PedidoCafeteria {
  id          String            @id @default(cuid())
  cafeteriaId String
  cafeteria   Cafeteria         @relation(fields: [cafeteriaId], references: [id], onDelete: Cascade)
  productoId  String
  producto    ProductoCafeteria @relation(fields: [productoId], references: [id], onDelete: Cascade)
  date        DateTime
  quantity    Int
  unitPrice   Decimal           @db.Decimal(14, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cafeteriaId, productoId, date])
  @@index([cafeteriaId, date])
}

/// Marca un mes de un café como facturado y liga el ingreso generado en
/// Ingresos y egresos. Único por café/mes: no se puede facturar dos veces.
model FacturaCafeteria {
  id          String          @id @default(cuid())
  cafeteriaId String
  cafeteria   Cafeteria       @relation(fields: [cafeteriaId], references: [id], onDelete: Cascade)
  year        Int
  month       Int
  amount      Decimal         @db.Decimal(14, 2) // total con IVA
  entryId     String?         @unique
  entry       FinancialEntry? @relation(fields: [entryId], references: [id], onDelete: SetNull)
  createdById String?
  createdBy   User?           @relation("FacturaCafeteriaCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@unique([cafeteriaId, year, month])
}
